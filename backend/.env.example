# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Base de datos. SQLite en desarrollo; en producción, PostgreSQL, por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/orientador
DATABASE_URL=sqlite:///./orientador.db

# Clave para firmar los JWT. Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Orígenes permitidos (CORS), separados por comas
CORS_ORIGINS=http://localhost:5173,https://carol878.github.io

# Días que se conservan candidaturas y decisiones antes de borrarlas (12 meses)
RETENTION_DAYS=365
